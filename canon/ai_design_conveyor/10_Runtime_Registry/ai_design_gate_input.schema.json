{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dnipro-m.local/ai-design/ai_design_gate_input.schema.json",
  "title":"AI Design Typed Gate Input",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evaluation_id","run_id","graph_version","run_state_sha256","edge_id","observed_trigger","facts","payload_result","required_receipt_results","authority_result","receiver_precheck","requested_at"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "evaluation_id":{"type":"string","pattern":"^GATE-[A-Z0-9][A-Z0-9_-]+$"},
    "run_id":{"type":"string","pattern":"^RUN-[A-Z0-9][A-Z0-9_-]+$"},
    "graph_version":{"type":"string","minLength":1},
    "run_state_sha256":{"$ref":"#/$defs/sha256"},
    "edge_id":{"$ref":"#/$defs/edgeId"},
    "observed_trigger": {
      "type":"object","additionalProperties":false,"required":["status","name","evidence_refs"],
      "properties":{"status":{"enum":["PRESENT","ABSENT","UNRESOLVED"]},"name":{"type":["string","null"]},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}
    },
    "facts":{"type":"array","items":{"$ref":"#/$defs/fact"}},
    "payload_result":{"$ref":"#/$defs/check"},
    "required_receipt_results":{"type":"array","items":{"$ref":"#/$defs/receiptCheck"}},
    "authority_result":{"$ref":"#/$defs/check"},
    "receiver_precheck":{"$ref":"#/$defs/check"},
    "requested_at":{"type":"string","format":"date-time"}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "edgeId":{"type":"string","pattern":"^E[0-9]{3}_[A-Z0-9_]+$"},
    "value":{"oneOf":[{"type":"boolean"},{"type":"number"},{"type":"string"},{"type":"array","items":{"oneOf":[{"type":"boolean"},{"type":"number"},{"type":"string"}]}}]},
    "fact": {
      "type":"object","additionalProperties":false,"required":["fact_id","value","evaluator_class","freshness_status","evidence_refs"],
      "properties":{"fact_id":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"value":{"$ref":"#/$defs/value"},"evaluator_class":{"enum":["DETERMINISTIC","HUMAN_SEMANTIC","EXTERNAL_RECEIPT"]},"freshness_status":{"enum":["CURRENT","STALE","UNKNOWN"]},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}
    },
    "check":{"type":"object","additionalProperties":false,"required":["status","evidence_refs"],"properties":{"status":{"enum":["PASS","FAIL","UNRESOLVED","NOT_REQUIRED"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}}},
    "receiptCheck":{"type":"object","additionalProperties":false,"required":["receipt_type","status","receipt_ref"],"properties":{"receipt_type":{"type":"string","minLength":1},"status":{"enum":["PASS","MISSING","INVALID"]},"receipt_ref":{"type":["string","null"]}}}
  }
}

