{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dnipro-m.local/ai-design/ai_design_gate_evaluation.schema.json",
  "title":"AI Design Typed Gate Evaluation",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evaluation_id","input_ref","input_sha256","run_id","graph_version","run_state_sha256","edge_id","trigger_result","guard_result","atom_results","payload_result","required_receipt_results","authority_result","receiver_precheck","eligible","rejection_reason_codes","evaluated_at","evaluator_version"],
  "properties": {
    "schema_version":{"const":"1.0"},"evaluation_id":{"type":"string","pattern":"^GATE-[A-Z0-9][A-Z0-9_-]+$"},"input_ref":{"type":"string","minLength":1},"input_sha256":{"$ref":"#/$defs/sha256"},"run_id":{"type":"string","pattern":"^RUN-[A-Z0-9][A-Z0-9_-]+$"},"graph_version":{"type":"string","minLength":1},"run_state_sha256":{"$ref":"#/$defs/sha256"},"edge_id":{"$ref":"#/$defs/edgeId"},
    "trigger_result":{"$ref":"#/$defs/check"},"guard_result":{"$ref":"#/$defs/check"},"atom_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/atom"}},"payload_result":{"$ref":"#/$defs/check"},"required_receipt_results":{"type":"array","items":{"$ref":"#/$defs/receiptCheck"}},"authority_result":{"$ref":"#/$defs/check"},"receiver_precheck":{"$ref":"#/$defs/check"},"eligible":{"type":"boolean"},"rejection_reason_codes":{"type":"array","uniqueItems":true,"items":{"enum":["TRIGGER_FALSE","TRIGGER_UNRESOLVED","GUARD_FALSE","GUARD_UNRESOLVED","PAYLOAD_INVALID","PAYLOAD_UNRESOLVED","RECEIPT_MISSING","RECEIPT_INVALID","AUTHORITY_MISSING","AUTHORITY_UNRESOLVED","RECEIVER_NOT_READY","RECEIVER_UNRESOLVED"]}},"evaluated_at":{"type":"string","format":"date-time"},"evaluator_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"edgeId":{"type":"string","pattern":"^E[0-9]{3}_[A-Z0-9_]+$"},
    "value":{"oneOf":[{"type":"null"},{"type":"boolean"},{"type":"number"},{"type":"string"},{"type":"array","items":{"oneOf":[{"type":"boolean"},{"type":"number"},{"type":"string"}]}}]},
    "check":{"type":"object","additionalProperties":false,"required":["status","evidence_refs"],"properties":{"status":{"enum":["PASS","FAIL","UNRESOLVED","NOT_REQUIRED"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}}},
    "receiptCheck":{"type":"object","additionalProperties":false,"required":["receipt_type","status","receipt_ref"],"properties":{"receipt_type":{"type":"string","minLength":1},"status":{"enum":["PASS","MISSING","INVALID"]},"receipt_ref":{"type":["string","null"]}}},
    "atom":{"type":"object","additionalProperties":false,"required":["atom_id","fact_id","operator","expected_value","actual_value","status","evidence_refs"],"properties":{"atom_id":{"type":"string","pattern":"^ATOM-[0-9]{2}$"},"fact_id":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"operator":{"enum":["EQ","GT","IN_SET","MEMBER_OF"]},"expected_value":{"$ref":"#/$defs/value"},"actual_value":{"$ref":"#/$defs/value"},"status":{"enum":["PASS","FAIL","UNRESOLVED"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}}}
  }
}
