{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dnipro-m.local/ai-design/ai_design_gate_evidence_bundle.schema.json",
  "title":"AI Design Gate Evidence Bundle",
  "type":"object","additionalProperties":false,
  "required":["schema_version","bundle_id","run_id","run_state_sha256","fact_evidence","edge_controls","created_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "bundle_id":{"type":"string","pattern":"^EVIDENCE-[A-Z0-9][A-Z0-9_-]+$"},
    "run_id":{"type":"string","pattern":"^RUN-[A-Z0-9][A-Z0-9_-]+$"},
    "run_state_sha256":{"$ref":"#/$defs/sha256"},
    "fact_evidence":{"type":"array","items":{"$ref":"#/$defs/factEvidence"}},
    "edge_controls":{"type":"array","items":{"$ref":"#/$defs/edgeControl"}},
    "created_at":{"type":"string","format":"date-time"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "edgeId":{"type":"string","pattern":"^E[0-9]{3}_[A-Z0-9_]+$"},
    "value":{"oneOf":[{"type":"boolean"},{"type":"number"},{"type":"string"},{"type":"array","items":{"oneOf":[{"type":"boolean"},{"type":"number"},{"type":"string"}]}}]},
    "check":{"type":"object","additionalProperties":false,"required":["status","evidence_refs"],"properties":{"status":{"enum":["PASS","FAIL","UNRESOLVED","NOT_REQUIRED"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}}},
    "receiptCheck":{"type":"object","additionalProperties":false,"required":["receipt_type","status","receipt_ref"],"properties":{"receipt_type":{"type":"string","minLength":1},"status":{"enum":["PASS","MISSING","INVALID"]},"receipt_ref":{"type":["string","null"]}}},
    "factEvidence":{
      "type":"object","additionalProperties":false,
      "required":["fact_id","value","provider_kind","provider_artifact_type","evaluator_class","source_ref","source_sha256","bound_run_id","bound_run_state_sha256","freshness_status","evidence_refs"],
      "properties":{
        "fact_id":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"value":{"$ref":"#/$defs/value"},
        "provider_kind":{"type":"string","minLength":1},"provider_artifact_type":{"type":"string","minLength":1},
        "evaluator_class":{"enum":["DETERMINISTIC","HUMAN_SEMANTIC","EXTERNAL_RECEIPT"]},
        "source_ref":{"type":"string","minLength":1},"source_sha256":{"$ref":"#/$defs/sha256"},
        "bound_run_id":{"type":"string","minLength":1},"bound_run_state_sha256":{"$ref":"#/$defs/sha256"},
        "freshness_status":{"enum":["CURRENT","STALE","UNKNOWN"]},
        "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "edgeControl":{
      "type":"object","additionalProperties":false,
      "required":["edge_id","observed_trigger","payload_result","required_receipt_results","authority_result","receiver_precheck"],
      "properties":{
        "edge_id":{"$ref":"#/$defs/edgeId"},
        "observed_trigger":{"type":"object","additionalProperties":false,"required":["status","name","evidence_refs"],"properties":{"status":{"enum":["PRESENT","ABSENT","UNRESOLVED"]},"name":{"type":["string","null"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}}},
        "payload_result":{"$ref":"#/$defs/check"},"required_receipt_results":{"type":"array","items":{"$ref":"#/$defs/receiptCheck"}},
        "authority_result":{"$ref":"#/$defs/check"},"receiver_precheck":{"$ref":"#/$defs/check"}
      }
    }
  }
}
