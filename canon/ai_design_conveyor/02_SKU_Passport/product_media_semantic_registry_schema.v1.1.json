{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_media_semantic_registry_schema.v1.1.json",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "status",
    "product",
    "assets",
    "emergent_jbtd_value_candidates",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "registry_id": {"type": "string"},
    "registry_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "product": {
      "type": "object",
      "required": ["product_root", "internal_code", "model", "version"]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "media_type",
          "original_filename",
          "current_filename",
          "canonical_path",
          "sha256",
          "source_id",
          "product_applicability",
          "observations",
          "creator_roles",
          "checklist_item_ids",
          "allowed_routes",
          "task_dispositions",
          "segments"
        ],
        "properties": {
          "asset_id": {"type": "string"},
          "media_type": {"enum": ["IMAGE", "VIDEO", "FRAME", "CLIP", "SOURCE_RECORD"]},
          "original_filename": {"type": "string"},
          "current_filename": {"type": "string"},
          "canonical_path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "source_id": {"type": "string"},
          "product_applicability": {"enum": ["EXACT", "POSSIBLE", "CONFLICT", "UNKNOWN"]},
          "observations": {"type": "array", "items": {"type": "object"}},
          "creator_roles": {"type": "array", "items": {"type": "string"}},
          "checklist_item_ids": {"type": "array", "items": {"type": "string"}},
          "value_jbtd_ids": {"type": "array", "items": {"type": "string"}},
          "allowed_routes": {
            "type": "array",
            "items": {"enum": ["DIRECT_REUSE", "CROP", "RETOUCH", "BACKGROUND_REPLACE", "EDIT", "COMPOSITE", "HYBRID", "GENERATIVE_REFERENCE", "GENERATE_NEW"]}
          },
          "task_dispositions": {"type": "array", "items": {"type": "object"}},
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["segment_id", "start_sec", "end_sec", "start_state", "action", "end_state", "creator_roles", "checklist_item_ids"]
            }
          }
        }
      }
    },
    "emergent_jbtd_value_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "candidate_type",
          "observed_action_or_result",
          "comparison_to_existing",
          "evidence_asset_ids",
          "evidence_segment_ids",
          "confidence",
          "status",
          "content_eligibility",
          "confirmation_owner",
          "created_at"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "candidate_type": {"enum": ["JBTD", "VALUE", "JBTD_AND_VALUE", "USE_CASE", "RESULT"]},
          "observed_action_or_result": {"type": "string", "minLength": 1},
          "comparison_to_existing": {"enum": ["MATCH_EXISTING", "EXTENDS_EXISTING", "NET_NEW", "CONFLICT", "UNRESOLVED"]},
          "matched_existing_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_asset_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_segment_ids": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "configuration_context": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["REQUIRES_CONFIRMATION", "CONFIRMED", "RECLASSIFIED_AS_SCENARIO", "REJECTED", "MERGED_WITH_EXISTING", "SUPERSEDED"]},
          "content_eligibility": {"enum": ["EVIDENCE_BOUND_VISUAL_USE", "CLAIM_COPY_ALLOWED", "NOT_ALLOWED"]},
          "owner_decision": {"enum": ["CONFIRM_AS_JBTD", "CONFIRM_AS_VALUE", "RECLASSIFY_AS_SCENARIO", "REJECT"]},
          "final_classification": {"enum": ["BUYER_JBTD", "PRODUCT_VALUE", "OPERATIONAL_SCENARIO", "REJECTED"]},
          "application_scope": {"type": "string"},
          "decision_rationale": {"type": "string"},
          "decided_at": {"type": "string"},
          "decided_by": {"type": "string"},
          "confirmation_question": {"type": "string"},
          "confirmation_owner": {"type": "string"},
          "passport_record_id": {"type": ["string", "null"]},
          "created_at": {"type": "string"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "timestamp", "actor", "event_type", "reason"]
      }
    }
  }
}
