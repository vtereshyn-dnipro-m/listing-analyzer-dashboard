{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","receipt_id","request_id","operation_id","idempotency_key","sku_id","result","current_before","archived_source","restored_new_passport","current_after","replaced_current_archive_receipt","canonical_pointer_count","downstream_invalidation_status","rollback_status","publication_authority","committed_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "receipt_id":{"type":"string","pattern":"^LS-RESTORE-RECEIPT-[A-Z0-9._-]+$"},
    "request_id":{"type":"string","minLength":1},
    "operation_id":{"type":"string","minLength":1},
    "idempotency_key":{"type":"string","minLength":16},
    "sku_id":{"type":"string","minLength":1},
    "result":{"enum":["RESTORE_ACCEPTED","RESTORE_IN_PROGRESS","RESTORE_REJECTED","RESTORE_COMMITTED","RESTORE_ROLLED_BACK"]},
    "current_before":{"$ref":"#/$defs/passport"},
    "archived_source":{"$ref":"#/$defs/passport"},
    "restored_new_passport":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/passport"}]},
    "current_after":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/passport"}]},
    "replaced_current_archive_receipt":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/binding"}]},
    "canonical_pointer_count":{"type":"integer","minimum":0,"maximum":1},
    "downstream_invalidation_status":{"enum":["NOT_STARTED","STALE_BINDINGS_RECORDED","FAILED"]},
    "rollback_status":{"enum":["NOT_REQUIRED","COMPLETED","RECOVERY_REQUIRED"]},
    "publication_authority":{"const":"NOT_GRANTED"},
    "committed_at":{"type":["string","null"],"format":"date-time"}
  },
  "allOf":[
    {"if":{"properties":{"result":{"const":"RESTORE_COMMITTED"}},"required":["result"]},"then":{"properties":{"restored_new_passport":{"$ref":"#/$defs/passport"},"current_after":{"$ref":"#/$defs/passport"},"replaced_current_archive_receipt":{"$ref":"#/$defs/binding"},"canonical_pointer_count":{"const":1},"downstream_invalidation_status":{"const":"STALE_BINDINGS_RECORDED"},"rollback_status":{"const":"NOT_REQUIRED"},"committed_at":{"type":"string","format":"date-time"}}}},
    {"if":{"properties":{"result":{"const":"RESTORE_ROLLED_BACK"}},"required":["result"]},"then":{"properties":{"restored_new_passport":{"const":null},"current_after":{"$ref":"#/$defs/passport"},"canonical_pointer_count":{"const":1},"rollback_status":{"const":"COMPLETED"},"committed_at":{"const":null}}}}
  ],
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "binding":{"type":"object","additionalProperties":false,"required":["ref","sha256"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}},
    "passport":{"type":"object","additionalProperties":false,"required":["passport_id","passport_lineage_id","version","path","sha256","lifecycle_status"],"properties":{"passport_id":{"type":"string","minLength":1},"passport_lineage_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"},"lifecycle_status":{"enum":["ACTIVE","ARCHIVED","STAGING","QUARANTINED"]}}}
  }
}
