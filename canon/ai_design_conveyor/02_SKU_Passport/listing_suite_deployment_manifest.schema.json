{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","deployment_id","environment","deployed_at","deployed_by","adapter_version","contract_bindings","implementation_status","feature_flags","test_receipts","secrets_embedded","publication_authority"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "deployment_id":{"type":"string","pattern":"^LS-DEPLOYMENT-[A-Z0-9._-]+$"},
    "environment":{"enum":["DEV","TEST","STAGING","PRODUCTION"]},
    "deployed_at":{"type":"string","format":"date-time"},
    "deployed_by":{"type":"string","minLength":1},
    "adapter_version":{"type":"string","minLength":1},
    "contract_bindings":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/binding"}},
    "implementation_status":{
      "type":"object","additionalProperties":false,
      "required":["source_evidence_delta","folder_snapshot_v1","passport_recreate","passport_restore","status_lookup"],
      "properties":{
        "source_evidence_delta":{"$ref":"#/$defs/status"},
        "folder_snapshot_v1":{"$ref":"#/$defs/status"},
        "passport_recreate":{"$ref":"#/$defs/status"},
        "passport_restore":{"$ref":"#/$defs/status"},
        "status_lookup":{"$ref":"#/$defs/status"}
      }
    },
    "feature_flags":{
      "type":"object","additionalProperties":false,
      "required":["listing_suite.source_evidence_delta","listing_suite.folder_snapshot_v1","listing_suite.passport_recreate","listing_suite.passport_restore"],
      "properties":{
        "listing_suite.source_evidence_delta":{"enum":["OFF","ON"]},
        "listing_suite.folder_snapshot_v1":{"enum":["OFF","ON"]},
        "listing_suite.passport_recreate":{"enum":["OFF","ON"]},
        "listing_suite.passport_restore":{"enum":["OFF","ON"]}
      }
    },
    "test_receipts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/receipt"}},
    "secrets_embedded":{"const":false},
    "publication_authority":{"const":"NOT_GRANTED"}
  },
  "allOf":[
    {"if":{"properties":{"feature_flags":{"properties":{"listing_suite.source_evidence_delta":{"const":"ON"}},"required":["listing_suite.source_evidence_delta"]}}},"then":{"properties":{"implementation_status":{"properties":{"source_evidence_delta":{"const":"VERIFIED"}}},"test_receipts":{"minItems":1}}}},
    {"if":{"properties":{"feature_flags":{"properties":{"listing_suite.folder_snapshot_v1":{"const":"ON"}},"required":["listing_suite.folder_snapshot_v1"]}}},"then":{"properties":{"implementation_status":{"properties":{"folder_snapshot_v1":{"const":"VERIFIED"}}},"test_receipts":{"minItems":1}}}},
    {"if":{"properties":{"feature_flags":{"properties":{"listing_suite.passport_recreate":{"const":"ON"}},"required":["listing_suite.passport_recreate"]}}},"then":{"properties":{"implementation_status":{"properties":{"passport_recreate":{"const":"VERIFIED"}}},"test_receipts":{"minItems":1}}}},
    {"if":{"properties":{"feature_flags":{"properties":{"listing_suite.passport_restore":{"const":"ON"}},"required":["listing_suite.passport_restore"]}}},"then":{"properties":{"implementation_status":{"properties":{"passport_restore":{"const":"VERIFIED"}}},"test_receipts":{"minItems":1}}}}
  ],
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "status":{"enum":["NOT_IMPLEMENTED","IMPLEMENTED_NOT_VERIFIED","VERIFIED"]},
    "binding":{"type":"object","additionalProperties":false,"required":["artifact_path","artifact_version","sha256"],"properties":{"artifact_path":{"type":"string","minLength":1},"artifact_version":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}},
    "receipt":{"type":"object","additionalProperties":false,"required":["test_receipt_id","scope","sha256"],"properties":{"test_receipt_id":{"type":"string","minLength":1},"scope":{"enum":["SOURCE_EVIDENCE_DELTA","FOLDER_SNAPSHOT_V1","PASSPORT_RECREATE","PASSPORT_RESTORE","STATUS_LOOKUP"]},"sha256":{"$ref":"#/$defs/sha"}}}
  }
}
