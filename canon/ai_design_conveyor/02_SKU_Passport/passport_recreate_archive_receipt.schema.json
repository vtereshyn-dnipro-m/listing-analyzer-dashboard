{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","archive_receipt_id","operation_id","sku_id","old_passport","archive_path","archive_manifest_sha256","replaced_by_passport_id","actor_id","timestamp","policy_version","status","error_code","recovery_action"],"properties":{"schema_version":{"const":"1.0"},"archive_receipt_id":{"type":"string","pattern":"^PSP-ARCHIVE-[A-Z0-9._-]+$"},"operation_id":{"type":"string","minLength":1},"sku_id":{"type":"string","minLength":1},"old_passport":{"type":"object","additionalProperties":false,"required":["passport_id","version","path","sha256"],"properties":{"passport_id":{"type":"string"},"version":{"type":"string"},"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"archive_path":{"type":"string","minLength":1},"archive_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"replaced_by_passport_id":{"type":"string","minLength":1},"actor_id":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"policy_version":{"type":"string","minLength":1},"status":{"enum":["PREPARED","COMMITTED","ROLLED_BACK"]},"error_code":{"type":["string","null"]},"recovery_action":{"type":["string","null"]}}}
