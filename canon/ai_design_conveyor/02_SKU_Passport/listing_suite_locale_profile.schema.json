{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","profile_id","profile_version","effective_at","default_locale","fallback_locale","enabled_locales","planned_locales","resolution_order","approved_by","profile_sha256"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "profile_id":{"type":"string","pattern":"^LS-LOCALE-PROFILE-[A-Z0-9._-]+$"},
    "profile_version":{"type":"string","minLength":1},
    "effective_at":{"type":"string","format":"date-time"},
    "default_locale":{"const":"uk-UA"},
    "fallback_locale":{"const":"uk-UA"},
    "enabled_locales":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"enum":["uk-UA","ru-RU"]},"allOf":[{"contains":{"const":"uk-UA"}},{"contains":{"const":"ru-RU"}}]},
    "planned_locales":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["en-US"]},"contains":{"const":"en-US"}},
    "resolution_order":{"type":"array","prefixItems":[{"const":"USER_PREFERENCE"},{"const":"ORGANIZATION_PREFERENCE"},{"const":"DEFAULT_LOCALE"}],"minItems":3,"maxItems":3},
    "approved_by":{"type":"string","minLength":1},
    "profile_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
