{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","requested_action","actor_id","acted_at","sku_id","collection_id","expected_manifest_version","expected_manifest_sha256","execution_mode","target_type","target_ids","decision","evidence_artifact_ids","reason","idempotency_key"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "request_id":{"type":"string","pattern":"^IMAGE-COLLECTION-ACTION-[A-Z0-9._-]+$"},
    "requested_action":{"enum":["CONFIRM_ASSET_SKU_REVISION","PROVIDE_LAWFUL_ACCESS_ARTIFACT","EXCLUDE_SOURCE_FROM_SCOPE","ACCEPT_PROPOSED_ASSET","REJECT_PROPOSED_ASSET","CONFIRM_COLLECTION_COMPLETE"]},
    "actor_id":{"type":"string","minLength":1},
    "acted_at":{"type":"string","format":"date-time"},
    "sku_id":{"type":"string","minLength":1},
    "collection_id":{"type":"string","minLength":1},
    "expected_manifest_version":{"type":"string","minLength":1},
    "expected_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "execution_mode":{"enum":["STANDARD","PILOT_REVIEW_ONLY"]},
    "target_type":{"enum":["SOURCE","ASSET","COLLECTION"]},
    "target_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "decision":{"enum":["CONFIRM","ACCEPT","REJECT","EXCLUDE","PROVIDE_EVIDENCE"]},
    "evidence_artifact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reason":{"type":"string","minLength":1},
    "idempotency_key":{"type":"string","minLength":16}
  },
  "allOf":[
    {"if":{"properties":{"requested_action":{"const":"PROVIDE_LAWFUL_ACCESS_ARTIFACT"}},"required":["requested_action"]},"then":{"properties":{"target_type":{"const":"SOURCE"},"decision":{"const":"PROVIDE_EVIDENCE"},"evidence_artifact_ids":{"minItems":1}}}},
    {"if":{"properties":{"requested_action":{"const":"EXCLUDE_SOURCE_FROM_SCOPE"}},"required":["requested_action"]},"then":{"properties":{"target_type":{"const":"SOURCE"},"decision":{"const":"EXCLUDE"}}}},
    {"if":{"properties":{"requested_action":{"enum":["CONFIRM_ASSET_SKU_REVISION","ACCEPT_PROPOSED_ASSET","REJECT_PROPOSED_ASSET"]}},"required":["requested_action"]},"then":{"properties":{"target_type":{"const":"ASSET"}}}},
    {"if":{"properties":{"requested_action":{"const":"CONFIRM_COLLECTION_COMPLETE"}},"required":["requested_action"]},"then":{"properties":{"execution_mode":{"const":"STANDARD"},"target_type":{"const":"COLLECTION"},"decision":{"const":"CONFIRM"},"target_ids":{"minItems":1,"maxItems":1}}}}
  ]
}
